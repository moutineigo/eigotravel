# このファイルをコピーして「.env.deploy」という名前で保存し、実際のさくらサーバーの情報を入れてください。
#   cp .env.deploy.example .env.deploy
# .env.deploy は .gitignore 対象なので、間違ってGitにコミットされることはありません。

DEPLOY_HOST=example.sakura.ne.jp
DEPLOY_USER=your-ssh-user
DEPLOY_PATH=/home/your-account/www

# 本番の管理画面を推測されにくいURLで公開するためのパス名（パスワード保護は無し）。
# 適当なランダム文字列にする。例: node -e "console.log(require('crypto').randomBytes(15).toString('base64url'))"
ADMIN_SECRET_PATH=

# お問い合わせフォームのスパム対策（信号機クイズ）用の署名シークレット。
# リポジトリは公開なので、このファイル経由でのみサーバーに渡す（app.py には直書きしない）。
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
CONTACT_CAPTCHA_SECRET=
